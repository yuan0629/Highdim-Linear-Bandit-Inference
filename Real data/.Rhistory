library(ggplot2)
library(DebiasInfer)
library(caret)
library(glmnet)
library(latex2exp)
setwd("")
options(warn=-1)
load("dataall.RData")
Time <- nrow(dataallnew)
d <- ncol(dataallnew) + 1
# sample 700 optimal samples belongs to three arms, respectively
set.seed(0122)
permutation1 <- sample(which(reward == 2), 700)
permutation2 <- sample(which(reward == 1), 700)
permutation0 <- sample(which(reward == 0), 700)
permutation <- sample(c(permutation1, permutation2, permutation0), 2100)
dataX <- data.matrix(dataallnew[permutation,])
model2ols <- lm((reward == 2)[permutation] ~ dataX)
model2ols$coefficients
summary(model2ols)
model1ols <- lm((reward == 1)[permutation] ~ dataX)
model1ols$coefficients
summary(model1ols)
model0ols <- lm((reward == 0)[permutation] ~ dataX)
model0ols$coefficients
summary(model0ols)
real <- matrix(0, nrow = d, ncol = 9)
real[, 1] <- model0ols$coefficients
real[, 2] <- confint(model0ols)[,1]
real[, 3] <- confint(model0ols)[,2]
real[, 4] <- model1ols$coefficients
real[, 5] <- confint(model1ols)[,1]
real[, 6] <- confint(model1ols)[,2]
real[, 7] <- model2ols$coefficients
real[, 8] <- confint(model2ols)[,1]
real[, 9] <- confint(model2ols)[,2]
# tuning parameters
gamma <- 1/3
c2 <- 5  # define the exploration probability \varepsilon_t=c_2t^{-gamma}
K <- 100 # number of iterations to solve (9) to obtain the de-correlation matrix M_T
s <- 20 # sparsity used in hard-thresholding
eta <- 0.02 # stepsize
set.seed(0122)
result1 <- matrix(0, nrow = d, ncol = 15) # store the point and interval estimators
beta2hat <- beta1hat <- beta0hat <- matrix(0, ncol = 1, nrow = d)
ipw2sum1 <- ipw2sum2 <- ipw1sum1 <- ipw1sum2 <- ipw0sum1 <- ipw0sum2 <- 0
sigma2hat <- sigma1hat <- sigma0hat <- 0
Sigma <- Lambda2 <- Lambda1 <- Lambda0 <- Sigma2 <- Sigma1 <- Sigma0 <- matrix(0, ncol = d, nrow = d)
g0 <- g1 <- g2 <- matrix(0, ncol = 1, nrow = d)
S2 <- S1 <- S0 <- rep(0, d)
GT2 <- GT1 <- GT0 <- 0
MT <- matrix(0, ncol = d, nrow = d)
Timenew <- 0
for (t in permutation) {
#print(t)
# observe context X_t
Xt <- matrix(c(1, as.numeric(dataallnew[t,])), ncol = 1)
Timenew <- Timenew + 1
# decision
epsilon <- min(1, c2*Timenew^(-gamma))
pit2 <- (1-epsilon) * ((t(beta2hat) %*% Xt >= t(beta0hat) %*% Xt) && (t(beta2hat) %*% Xt >= t(beta1hat) %*% Xt))[[1]] + epsilon/3
pit1 <- (1-epsilon) * ((t(beta1hat) %*% Xt >= t(beta0hat) %*% Xt) && (t(beta1hat) %*% Xt > t(beta2hat) %*% Xt))[[1]] + epsilon/3
pit0 <- (1-epsilon) * ((t(beta0hat) %*% Xt > t(beta2hat) %*% Xt) && (t(beta0hat) %*% Xt > t(beta1hat) %*% Xt))[[1]] + epsilon/3
ac <- sample(c(0,1,2), prob = c(pit0, pit1, pit2), 1)
y <- (ac == reward[t])
ipw2sum1 <- ipw2sum1 + (ac==2) * 1/pit2 * Xt %*% y
ipw2sum2 <- ipw2sum2 + (ac==2) * 1/pit2 * Xt %*% t(Xt)
ipw1sum1 <- ipw1sum1 + (ac==1) * 1/pit1 * Xt %*% y
ipw1sum2 <- ipw1sum2 + (ac==1) * 1/pit1 * Xt %*% t(Xt)
ipw0sum1 <- ipw0sum1 + (ac==0) * 1/pit0 * Xt %*% y
ipw0sum2 <- ipw0sum2 + (ac==0) * 1/pit0 * Xt %*% t(Xt)
GT1 <- GT1 + (ac == 1)
GT0 <- GT0 + (ac == 0)
GT2 <- GT2 + (ac == 2)
# variance estimation
sigma2hat <- sigma2hat + (ac == 2) / pit2 * (y - t(Xt) %*% beta2hat)^2
sigma1hat <- sigma1hat + (ac == 1) / pit1 * (y - t(Xt) %*% beta1hat)^2
sigma0hat <- sigma0hat + (ac == 0) / pit0 * (y - t(Xt) %*% beta0hat)^2
# estimation
Sigma0 <- (Timenew-1)/Timenew*Sigma0 + (ac==0) * 1/Timenew * 1/pit0 * Xt %*% t(Xt)
Sigma1 <- (Timenew-1)/Timenew*Sigma1 + (ac==1) * 1/Timenew * 1/pit1 * Xt %*% t(Xt)
Sigma2 <- (Timenew-1)/Timenew*Sigma2 + (ac==2) * 1/Timenew * 1/pit2 * Xt %*% t(Xt)
g0 <- (Timenew-1)/Timenew*g0 + (ac==0) * 1/Timenew * 1/pit0 * Xt %*% y
g1 <- (Timenew-1)/Timenew*g1 + (ac==1) * 1/Timenew * 1/pit1 * Xt %*% y
g2 <- (Timenew-1)/Timenew*g2 + (ac==2) * 1/Timenew * 1/pit2 * Xt %*% y
# update beta0
g <- 2 * Sigma0 %*% beta0hat - 2 * g0
beta0hat <- beta0hat - eta * g
beta0hat[-order(abs(beta0hat), decreasing = TRUE)[1:s]] <- 0
# update beta1
g <- 2 * Sigma1 %*% beta1hat - 2 * g1
beta1hat <- beta1hat - eta * g
beta1hat[-order(abs(beta1hat), decreasing = TRUE)[1:s]] <- 0
# update beta2
g <- 2 * Sigma2 %*% beta2hat - 2 * g2
beta2hat <- beta2hat - eta * g
beta2hat[-order(abs(beta2hat), decreasing = TRUE)[1:s]] <- 0
Sigma <- (Timenew-1)/Timenew * Sigma + 1/Timenew * Xt %*% t(Xt)
Lambda0 <- (Timenew-1)/Timenew*Lambda0 + (ac==0) * 1/Timenew * Xt %*% t(Xt)
Lambda1 <- (Timenew-1)/Timenew*Lambda1 + (ac==1) * 1/Timenew * Xt %*% t(Xt)
Lambda2 <- (Timenew-1)/Timenew*Lambda2 + (ac==2) * 1/Timenew * Xt %*% t(Xt)
}
# noise level estimators
sigma2hat <- sigma2hat / Timenew
sigma1hat <- sigma1hat / Timenew
sigma0hat <- sigma0hat / Timenew
# constructing de-correlation matrix M_T
mu <- 0.5 * sqrt(log(d) / (Timenew))
for (l in 1:d) {
mt <- matrix(0, ncol = d, nrow = 1)
for (k in 1:K) {
for (j in 1:d) {
mt[j] <- 1/(Sigma[j, j]+0.001) * SoftThres(- Sigma[j, -j] %*% t(mt)[-j] + (l == j), mu)
}
}
MT[l,] <- mt
# variance estimation
S2[l] <- 3 / c2 / (1+gamma) * mt %*% Lambda0 %*% t(mt) + 3 / c2 / (1+gamma) * mt %*% Lambda1 %*% t(mt) + Timenew^(-gamma) * mt %*% Lambda2 %*% t(mt)
S1[l] <- 3 / c2 / (1+gamma) * mt %*% Lambda0 %*% t(mt) + 3 / c2 / (1+gamma) * mt %*% Lambda2 %*% t(mt) + Timenew^(-gamma) * mt %*% Lambda1 %*% t(mt)
S0[l] <- 3 / c2 / (1+gamma) * mt %*% Lambda1 %*% t(mt) + 3 / c2 / (1+gamma) * mt %*% Lambda2 %*% t(mt) + Timenew^(-gamma) * mt %*% Lambda0 %*% t(mt)
}
# IPW debiased estimator
beta2ipw <- beta2hat + 1/Timenew * MT %*% (ipw2sum1- ipw2sum2 %*% beta2hat)
beta1ipw <- beta1hat + 1/Timenew * MT %*% (ipw1sum1- ipw1sum2 %*% beta1hat)
beta0ipw <- beta0hat + 1/Timenew * MT %*% (ipw0sum1- ipw0sum2 %*% beta0hat)
# point estimator and 95% CI for \beta_1,\beta_2 and \beta_0
result1[, 1] <- beta0ipw
result1[, 2] <- beta0ipw - qnorm(0.975) * sqrt(sigma0hat * S0 / Timenew^(1-gamma))
result1[, 3] <- beta0ipw + qnorm(0.975) * sqrt(sigma0hat * S0 / Timenew^(1-gamma))
result1[, 4] <- beta1ipw
result1[, 5] <- beta1ipw - qnorm(0.975) * sqrt(sigma1hat * S1 / Timenew^(1-gamma))
result1[, 6] <- beta1ipw + qnorm(0.975) * sqrt(sigma1hat * S1 / Timenew^(1-gamma))
result1[, 7] <- beta2ipw
result1[, 8] <- beta2ipw - qnorm(0.975) * sqrt(sigma2hat * S2 / Timenew^(1-gamma))
result1[, 9] <- beta2ipw + qnorm(0.975) * sqrt(sigma2hat * S2 / Timenew^(1-gamma))
# point estimator and 95% CI for \beta_0-\beta_1, \beta_0-\beta_2 and \beta_1-\beta_2
result1[, 10] <- beta0ipw  - beta1ipw - qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma1hat * S1)/ Timenew^(1-gamma))
result1[, 11] <- beta0ipw  - beta1ipw + qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma1hat * S1)/ Timenew^(1-gamma))
result1[, 12] <- beta0ipw  - beta2ipw - qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma2hat * S2)/ Timenew^(1-gamma))
result1[, 13] <- beta0ipw  - beta2ipw + qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma2hat * S2)/ Timenew^(1-gamma))
result1[, 14] <- beta1ipw  - beta2ipw - qnorm(0.975) * sqrt((sigma2hat * S2 +  sigma1hat * S1)/ Timenew^(1-gamma))
result1[, 15] <- beta1ipw  - beta2ipw + qnorm(0.975) * sqrt((sigma2hat * S2 +  sigma1hat * S1)/ Timenew^(1-gamma))
# parameters
Time <- nrow(dataallnew)
d <- ncol(dataallnew) + 1
K <- 100 # number of iterations to solve (10) to obtain the de-correlation matrix M_T^{(i)}
eta <- 0.07 # stepsize
s <- 20
result2 <- matrix(0, nrow = d, ncol = 15) # store the results
beta2hat <- beta1hat <- beta0hat <- matrix(0, ncol = 1, nrow = d)
aw2sum1 <- aw2sum2 <- aw1sum1 <- aw1sum2 <- aw0sum1 <- aw0sum2 <- 0
sigma2hat <- sigma1hat <- sigma0hat <- 0
Sigma2 <- Sigma1 <- Sigma0 <- matrix(0, ncol = d, nrow = d)
g0 <- g1 <- g2 <- matrix(0, ncol = 1, nrow = d)
m2t <- m1t <- m0t <- matrix(0, ncol = d, nrow = 1)
GT2 <- GT1 <- GT0 <- WT1 <- WT2 <- Vhat <- 0
Timenew <- 0
set.seed(0122)
for (t in permutation) {
Xt <- matrix(c(1, as.numeric(dataallnew[t,])), ncol = 1)
Timenew <- Timenew + 1
# decision
pit2 <- (t(beta2hat) %*% Xt > t(beta0hat) %*% Xt) && (t(beta2hat) %*% Xt > t(beta1hat) %*% Xt)[[1]]
pit1 <- (t(beta1hat) %*% Xt > t(beta0hat) %*% Xt) && (t(beta1hat) %*% Xt > t(beta2hat) %*% Xt)[[1]]
pit0 <- (t(beta0hat) %*% Xt > t(beta2hat) %*% Xt) && (t(beta0hat) %*% Xt > t(beta1hat) %*% Xt)[[1]]
if ((pit2 == 0) && (pit1 == 0) && (pit0 == 0)) {
pit2 <- pit1 <- pit0 <- 1/3
}
ac <- sample(c(0,1,2), prob = c(pit0, pit1, pit2), 1)
y <- (ac == reward[t])
aw1sum1 <- aw1sum1 + (ac==1) * Xt %*% y
aw1sum2 <- aw1sum2 + (ac==1) * Xt %*% t(Xt)
aw0sum1 <- aw0sum1 + (ac==0) * Xt %*% y
aw0sum2 <- aw0sum2 + (ac==0) * Xt %*% t(Xt)
aw2sum1 <- aw2sum1 + (ac==2) * Xt %*% y
aw2sum2 <- aw2sum2 + (ac==2) * Xt %*% t(Xt)
GT1 <- GT1 + (ac == 1)
GT0 <- GT0 + (ac == 0)
GT2 <- GT2 + (ac == 2)
# noise level estimator
sigma2hat <- sigma2hat + (ac == 2) * (y - t(Xt) %*% beta2hat)^2
sigma1hat <- sigma1hat + (ac == 1) * (y - t(Xt) %*% beta1hat)^2
sigma0hat <- sigma0hat + (ac == 0) * (y - t(Xt) %*% beta0hat)^2
# online estimation update
Sigma0 <- (Timenew-1)/Timenew*Sigma0 + (ac==0) * 1/Timenew * Xt %*% t(Xt)
Sigma1 <- (Timenew-1)/Timenew*Sigma1 + (ac==1) * 1/Timenew * Xt %*% t(Xt)
Sigma2 <- (Timenew-1)/Timenew*Sigma2 + (ac==2) * 1/Timenew * Xt %*% t(Xt)
g0 <- (Timenew-1)/Timenew*g0 + (ac==0) * 1/Timenew  * Xt %*% y
g1 <- (Timenew-1)/Timenew*g1 + (ac==1) * 1/Timenew  * Xt %*% y
g2 <- (Timenew-1)/Timenew*g2 + (ac==2) * 1/Timenew  * Xt %*% y
# update beta0
g <- 2 * Sigma0 %*% beta0hat - 2 * g0
beta0hat <- beta0hat - eta * g
beta0hat[-order(abs(beta0hat), decreasing = TRUE)[1:s]] <- 0
# update beta1
g <- 2 * Sigma1 %*% beta1hat - 2 * g1
beta1hat <- beta1hat - eta * g
beta1hat[-order(abs(beta1hat), decreasing = TRUE)[1:s]] <- 0
# update beta2
g <- 2 * Sigma2 %*% beta2hat - 2 * g2
beta2hat <- beta2hat - eta * g
beta2hat[-order(abs(beta2hat), decreasing = TRUE)[1:s]] <- 0
}
# noise level estimator
sigma1hat <- sigma1hat / GT1
sigma0hat <- sigma0hat / GT0
sigma2hat <- sigma2hat / GT2
# constructing de-correlation matrix M_T^{(i)}
M1T <- M0T <- M2T <- matrix(0, ncol = d, nrow = d)
S1 <- S0 <- S2 <- rep(0, d)
mu <- 3 * sqrt(log(d) / Timenew)
for (l in 1:d) {
m1t <- matrix(0, ncol = d, nrow = 1)
for (k in 1:K) {
for (j in 1:d) {
m1t[j] <- 1/(Sigma1[j, j]+0.01*(Sigma1[j, j] == 0)) * SoftThres(- Sigma1[j, -j] %*% t(m1t)[-j] + (l == j), mu)
}
}
M1T[l,] <- m1t
S1[l] <- m1t %*% Sigma1 %*% t(m1t)
}
for (l in 1:d) {
m0t <- matrix(0, ncol = d, nrow = 1)
for (k in 1:K) {
for (j in 1:d) {
m0t[j] <- 1/(Sigma0[j, j]+0.01*(Sigma0[j, j] == 0)) * SoftThres(- Sigma0[j, -j] %*% t(m0t)[-j] + (l == j), mu)
}
}
M0T[l,] <- m0t
S0[l] <- m0t %*% Sigma0 %*% t(m0t)
}
for (l in 1:d) {
m2t <- matrix(0, ncol = d, nrow = 1)
for (k in 1:K) {
for (j in 1:d) {
m2t[j] <- 1/(Sigma2[j, j]+0.01*(Sigma2[j, j] == 0)) * SoftThres(- Sigma2[j, -j] %*% t(m2t)[-j] + (l == j), mu)
}
}
M2T[l,] <- m2t
S2[l] <- m2t %*% Sigma2 %*% t(m2t)
}
# point estimator and 95% CI for \beta_1,\beta_2 and \beta_0
beta1aw <- beta1hat + 1/Timenew * M1T %*% (aw1sum1- aw1sum2 %*% beta1hat)
beta0aw <- beta0hat + 1/Timenew * M0T %*% (aw0sum1- aw0sum2 %*% beta0hat)
beta2aw <- beta2hat + 1/Timenew * M2T %*% (aw2sum1- aw2sum2 %*% beta2hat)
result2[, 1] <- beta0aw
result2[, 2] <- beta0aw - qnorm(0.975) * sqrt(sigma0hat * S0 / Timenew)
result2[, 3] <- beta0aw + qnorm(0.975) * sqrt(sigma0hat * S0 / Timenew)
result2[, 4] <- beta1aw
result2[, 5] <- beta1aw - qnorm(0.975) * sqrt(sigma1hat * S1 / Timenew)
result2[, 6] <- beta1aw + qnorm(0.975) * sqrt(sigma1hat * S1 / Timenew)
result2[, 7] <- beta2aw
result2[, 8] <- beta2aw - qnorm(0.975) * sqrt(sigma2hat * S2 / Timenew)
result2[, 9] <- beta2aw + qnorm(0.975) * sqrt(sigma2hat * S2 / Timenew)
# point estimator and 95% CI for \beta_0-\beta_1, \beta_0-\beta_2 and \beta_1-\beta_2
result2[, 10] <- beta0aw  - beta1aw - qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma1hat * S1)/ Timenew)
result2[, 11] <- beta0aw  - beta1aw + qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma1hat * S1)/ Timenew)
result2[, 12] <- beta0aw  - beta2aw - qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma2hat * S2)/ Timenew)
result2[, 13] <- beta0aw  - beta2aw + qnorm(0.975) * sqrt((sigma0hat * S0 +  sigma2hat * S2)/ Timenew)
result2[, 14] <- beta1aw  - beta2aw - qnorm(0.975) * sqrt((sigma2hat * S2 +  sigma1hat * S1)/ Timenew)
result2[, 15] <- beta1aw  - beta2aw + qnorm(0.975) * sqrt((sigma2hat * S2 +  sigma1hat * S1)/ Timenew)
variablename <- as.factor(c(1:d))
table1 <- data.frame(variable = variablename, value = result1[, 1], low = result1[, 2], high = result1[, 3])
table1$indicator <- ((table1$low >0) | (table1$high<0))
table1$method <- "IPW"
table2 <- data.frame(variable = variablename, value = result2[, 1], low = result2[, 2], high = result2[, 3])
table2$indicator <- ((table2$low >0) | (table2$high<0))
table2$method <- "AW"
table3 <- data.frame(variable = variablename, value = real[, 1], low = real[, 2], high = real[, 3])
table3$indicator <- ((table3$low >0) | (table3$high<0))
table3$method <- "OLS"
tablefinal <- rbind(table1, table2, table3)
finallist <- c()
for (i in 2:d) {
if (!is.na(sum(tablefinal[tablefinal$variable == variablename[i], "indicator"]))) {
if (sum(tablefinal[tablefinal$variable == variablename[i], "indicator"])>= 2) {
finallist <- c(finallist, variablename[i])
}
}
}
fig0 <- ggplot(tablefinal[which(tablefinal$variable %in% finallist), ], aes(x = variable, y = value, group = method, color = method)) +
geom_point(position=position_dodge(0.6))  +
geom_errorbar(aes(ymin = low, ymax = high),  position=position_dodge(0.6)) +
scale_color_manual(values = c("#386cb0", "#fdb462", "#7fc97f")) + xlab("variable") + ylab("") + theme_classic() + theme(axis.text.x = element_text(angle = 15, vjust = 0.5))
fig0
## Figure 4 middle: point and 95% CI of the significant variables in \beta_1 ###
variablename <- as.factor(c(1:d))
table1 <- data.frame(variable = variablename, value = result1[, 4], low = result1[, 5], high = result1[, 6])
table1$indicator <- ((table1$low >0) | (table1$high<0))
table1$method <- "IPW"
table2 <- data.frame(variable = variablename, value = result2[, 4], low = result2[, 5], high = result2[, 6])
table2$indicator <- ((table2$low >0) | (table2$high<0))
table2$method <- "AW"
table3 <- data.frame(variable = variablename, value = real[, 4], low = real[, 5], high = real[, 6])
table3$indicator <- ((table3$low >0) | (table3$high<0))
table3$method <- "OLS"
tablefinal <- rbind(table1, table2, table3)
finallist <- c()
for (i in 2:d) {
if (!is.na(sum(tablefinal[tablefinal$variable == variablename[i], "indicator"]))) {
if (sum(tablefinal[tablefinal$variable == variablename[i], "indicator"])>= 2) {
finallist <- c(finallist, variablename[i])
}
}
}
fig1 <- ggplot(tablefinal[which(tablefinal$variable %in% finallist), ], aes(x = variable, y = value, group = method, color = method)) +
geom_point(position=position_dodge(0.6))  +
geom_errorbar(aes(ymin = low, ymax = high),  position=position_dodge(0.6)) +
scale_color_manual(values = c("#386cb0", "#fdb462", "#7fc97f")) + xlab("variable") + ylab("") + theme_classic() + theme(axis.text.x = element_text(angle = 15, vjust = 0.5))
fig1
## Figure 4 bottom: point and 95% CI of the significant variables in \beta_2 ###
variablename <- as.factor(c(1:d))
table1 <- data.frame(variable = variablename, value = result1[, 7], low = result1[, 8], high = result1[, 9])
table1$indicator <- ((table1$low >0) | (table1$high<0))
table1$method <- "IPW"
table2 <- data.frame(variable = variablename, value = result2[, 7], low = result2[, 8], high = result2[, 9])
table2$indicator <- ((table2$low >0) | (table2$high<0))
table2$method <- "AW"
table3 <- data.frame(variable = variablename, value = real[, 7], low = real[, 8], high = real[, 9])
table3$indicator <- ((table3$low >0) | (table3$high<0))
table3$method <- "OLS"
tablefinal <- rbind(table1, table2, table3)
for (i in 2:d) {
if (!is.na(sum(tablefinal[tablefinal$variable == variablename[i], "indicator"]))) {
if (sum(tablefinal[tablefinal$variable == variablename[i], "indicator"])>= 2) {
finallist <- c(finallist, variablename[i])
}
}
}
fig2 <- ggplot(tablefinal[which(tablefinal$variable %in% finallist), ], aes(x = variable, y = value, group = method, color = method)) +
geom_point(position=position_dodge(0.6))  +
geom_errorbar(aes(ymin = low, ymax = high),  position=position_dodge(0.6)) +
scale_color_manual(values = c("#386cb0", "#fdb462", "#7fc97f")) + xlab("variable") + ylab("") + theme_classic() + theme(axis.text.x = element_text(angle = 15, vjust = 0.5))
fig2
## Figure 5 top: point and 95% CI of the significant variables under varepsilon_t=5t^{-1/3} ###
variablename <- as.factor(c(1:d))
table1 <- data.frame(variable = variablename, value = result1[, 1] - result1[, 4], low = result1[, 10], high = result1[, 11])
table1$parameter <- "01"
table1$indicator <- ((table1$low >0) | (table1$high<0))
table2 <- data.frame(variable = variablename, value = result1[, 1] - result1[, 7], low = result1[, 12], high = result1[, 13])
table2$parameter <- "02"
table2$indicator <- ((table2$low >0) | (table2$high<0))
table3 <- data.frame(variable = variablename, value = result1[, 4] - result1[, 7], low = result1[, 14], high = result1[, 15])
table3$parameter <- "12"
table3$indicator <- ((table3$low >0) | (table3$high<0))
tablefinal <- rbind(table1, table2, table3)
differencenodc <- ggplot(tablefinal[(tablefinal$indicator == 1) & (tablefinal$variable != "1"),], aes(x = variable, y = value, group = parameter, color = parameter)) + geom_point(position=position_dodge(0.6)) +
scale_color_manual(labels = c(TeX(r"(  $\beta_0$-$\beta_1$)"), TeX(r"($\beta_0$-$\beta_2$)"), TeX(r"($\beta_1$-$\beta_2$)")), values = c("#386cb0", "#fdb462", "#7fc97f")) +
geom_errorbar(aes(ymin = low, ymax = high),  position=position_dodge(0.6)) + xlab("variable") + ylab("") + theme_classic() + theme(axis.text.x = element_text(angle = 15, vjust = 0.5))
differencenodc
## Figure 5 bottom: point and 95% CI of the significant variables under varepsilon_t=0 ###
variablename <- as.factor(c(1:d))
table1 <- data.frame(variable = variablename, value = result2[, 1] - result2[, 4], low = result2[, 10], high = result2[, 11])
table1$parameter <- "01"
table1$indicator <- ((table1$low >0) | (table1$high<0))
table2 <- data.frame(variable = variablename, value = result2[, 1] - result2[, 7], low = result2[, 12], high = result2[, 13])
table2$parameter <- "02"
table2$indicator <- ((table2$low >0) | (table2$high<0))
table3 <- data.frame(variable = variablename, value = result2[, 4] - result2[, 7], low = result2[, 14], high = result2[, 15])
table3$parameter <- "12"
table3$indicator <- ((table3$low >0) | (table3$high<0))
tablefinal <- rbind(table1, table2, table3)
differencedc <- ggplot(tablefinal[(tablefinal$indicator == 1) & (tablefinal$variable != "1"),], aes(x = variable, y = value, group = parameter, color = parameter)) + geom_point(position=position_dodge(0.6)) +
scale_color_manual(labels = c(TeX(r"(  $\beta_0$-$\beta_1$)"), TeX(r"($\beta_0$-$\beta_2$)"), TeX(r"($\beta_1$-$\beta_2$)")), values = c("#386cb0", "#fdb462", "#7fc97f")) +
geom_errorbar(aes(ymin = low, ymax = high),  position=position_dodge(0.6)) + xlab("variable") + ylab("") + theme_classic() + theme(axis.text.x = element_text(angle = 15, vjust = 0.5))
differencedc
